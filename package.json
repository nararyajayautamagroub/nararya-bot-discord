{
  "name": "nararya-bot-discord",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "test": "node --test",
    "start:ticket": "node src/ticket-bot/index.js",
    "check:runtime": "npm run validate && find src test website -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "validate": "node tools/validate-repo.mjs",
    "test:all": "npm run validate && npm test",
    "start:web": "node src/index.js",
    "check:install": "npm install --no-audit --no-fund",
    "check:website": "npm test -- test/jkt48-website.test.js test/web-auth.test.js test/web-server.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.1"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "overrides": {
    "encoding-sniffer": "1.0.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
