{
  "name": "nararya-bot-discord",
  "version": "2.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "check": "tsc --noEmit",
    "test": "node --test",
    "start:ticket": "node src/ticket-bot/index.js",
    "check:runtime": "node --check src/index.js && node --check src/jkt48/adapters.js && node --check src/jkt48/sources.js && node --check src/ticket-bot/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.1"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "overrides": {
    "encoding-sniffer": "1.0.2"
  }
}
